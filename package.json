{
  "name": "dailies",
  "version": "0.0.0",
  "private": true,
  "description": "Browser extension and local dashboard that tracks your daily web games. Results stay in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:site": "vite dashboard",
    "build:site": "vite build dashboard",
    "typecheck:site": "tsc --noEmit -p dashboard",
    "test:site": "playwright test -c dashboard/playwright.config.ts",
    "build:ext": "tsx extension/build.ts",
    "typecheck:ext": "tsc --noEmit -p extension",
    "test:ext": "playwright test -c extension/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
